# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase Service Role Key (Required for LINE Webhook & Cron)
# Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: LINE Messaging API
# Keep all LINE secrets server-only. Never prefix them with NEXT_PUBLIC_.
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret
LINE_USER_ID=your-line-user-id

# Optional: Vercel Cron Secret (Recommended in production for /api/line-cron)
CRON_SECRET=your-random-cron-secret
